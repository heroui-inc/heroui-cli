{
  "name": "heroui-cli",
  "version": "3.0.5",
  "description": "A CLI tool that unlocks seamless HeroUI integration",
  "keywords": [
    "UI",
    "CLI",
    "Tool",
    "Template",
    "Integration",
    "HeroUI"
  ],
  "homepage": "https://github.com/heroui-inc/heroui-cli#readme",
  "bugs": {
    "url": "https://github.com/heroui-inc/heroui-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heroui-inc/heroui-cli.git"
  },
  "license": "MIT",
  "author": {
    "name": "HeroUI",
    "email": "support@heroui.com",
    "url": "https://github.com/heroui-inc"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "heroui": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "test": "pnpm --filter heroui-cli-test test:run",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "check:prettier": "prettier --check .",
    "check:types": "tsc --noEmit",
    "sync:docs": "tsx src/scripts/sync/sync.ts",
    "clean:cache": "tsx src/scripts/cache/clean.ts",
    "link:cli": "pnpm link --global",
    "link:remove": "pnpm uninstall --global heroui-cli",
    "changelog": "conventional-changelog -p angular -i CHANGELOG.md -s --commit-path .",
    "release": "bumpp --execute='pnpm run changelog' --all",
    "prepare": "husky",
    "prepublishOnly": "pnpm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@winches/prompts": "0.0.7",
    "async-retry": "1.3.3",
    "chalk": "5.6.2",
    "commander": "14.0.3",
    "compare-versions": "6.1.1",
    "empathic": "2.1.0",
    "envinfo": "7.21.0",
    "gradient-string": "2.0.2",
    "nanospinner": "1.2.2",
    "pathe": "2.0.3",
    "posthog-node": "5.55.0",
    "tar": "7.5.22"
  },
  "devDependencies": {
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "@types/async-retry": "1.4.9",
    "@types/envinfo": "7.8.4",
    "@types/gradient-string": "1.1.6",
    "@types/node": "20.19.43",
    "@typescript-eslint/eslint-plugin": "6.21.0",
    "@typescript-eslint/parser": "6.21.0",
    "bumpp": "10.4.1",
    "commitlint-plugin-function-rules": "4.3.2",
    "conventional-changelog": "8.1.3",
    "conventional-changelog-angular": "9.4.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.2",
    "eslint-import-resolver-typescript": "3.10.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-sort-destructure-keys": "1.6.0",
    "eslint-plugin-sort-keys-fix": "1.1.2",
    "eslint-plugin-unicorn": "52.0.0",
    "eslint-plugin-unused-imports": "3.2.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.9",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.22.0",
    "pnpm": ">=12"
  },
  "packageManager": "pnpm@12.8.2"
}
